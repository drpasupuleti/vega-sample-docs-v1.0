{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vega Sample Package",
  "description": "Reference implementation for the Vega OS Content Launcher and Media Controls APIs on Fire TV",
  "colors": {
    "primary": "#FF9900",
    "light": "#FFBB55",
    "dark": "#E88600"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/drpasupuleti/vega-sample-package"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Content Launcher API",
            "pages": [
              "content-launcher/overview",
              "content-launcher/types",
              "content-launcher/functions",
              "content-launcher/examples"
            ]
          },
          {
            "group": "Media Controls API",
            "pages": [
              "media-controls/overview",
              "media-controls/types",
              "media-controls/session-manager",
              "media-controls/endpoint-discovery",
              "media-controls/examples"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/drpasupuleti/vega-sample-package"
    }
  }
}
